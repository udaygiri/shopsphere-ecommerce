# ==========================================
# Role-Based E-Commerce Platform Config
# Copy this file to .env or use per-service .env
# ==========================================

# ------------------------------------------
# Backend Settings (FastAPI)
# ------------------------------------------
ENVIRONMENT=development
PORT=8000
FRONTEND_URL=http://localhost:5173

# Database: SQLite for local dev, PostgreSQL for production
# Local Dev (SQLite):
DATABASE_URL=sqlite:///./ecommerce.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql://user:password@localhost:5432/ecommerce_prod

# JWT Authentication
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cloudinary (Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay (Test Payment Gateway)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ------------------------------------------
# Frontend Settings (React / Vite)
# ------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
